rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function jobIsOwned(jobData) {
      return jobData.ownerUid != null && request.auth != null && request.auth.uid == jobData.ownerUid;
    }
    function jobIsPublicOrBeta(jobData) {
      return jobData.ownerUid == null || jobData.isPublic == true;
    }

    match /jobs/{jobId} {
      allow read: if jobIsOwned(resource.data) || jobIsPublicOrBeta(resource.data);
      allow write: if false;

      match /shots/{shotId} {
        allow read: if jobIsOwned(get(/databases/$(database)/documents/jobs/$(jobId)).data)
          || jobIsPublicOrBeta(get(/databases/$(database)/documents/jobs/$(jobId)).data);
        allow write: if false;
      }

      match /errors/{errorId} {
        allow read: if jobIsOwned(get(/databases/$(database)/documents/jobs/$(jobId)).data)
          || jobIsPublicOrBeta(get(/databases/$(database)/documents/jobs/$(jobId)).data);

        allow update: if (
          (
            jobIsOwned(get(/databases/$(database)/documents/jobs/$(jobId)).data)
            || jobIsPublicOrBeta(get(/databases/$(database)/documents/jobs/$(jobId)).data)
          ) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['userConfirmed', 'fixDirection', 'fixMode', 'replaceWith', 'fixStatus'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fixStatus'])
            || request.resource.data.fixStatus == 'pending'
          )
        );
        allow create, delete: if false;
      }

      match /verify_errors/{errorId} {
        allow read: if jobIsOwned(get(/databases/$(database)/documents/jobs/$(jobId)).data)
          || jobIsPublicOrBeta(get(/databases/$(database)/documents/jobs/$(jobId)).data);
        allow write: if false;
      }
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // `fixesUsedThisMonth` was renamed to `creditsUsedThisMonth` in the
      // application but not here, so the guard has been protecting a field
      // that no longer exists while the live monthly-usage counter — the one
      // the fix route's quota and ceiling checks both read — was left
      // client-writable. A signed-in user could reset their own usage to zero
      // from the browser and keep spending against the prepaid Runway pool.
      //
      // `emailDeliverable` and `emailVerified` are here for the same reason:
      // they gate whether an account may spend at all, so they must only ever
      // be written by the server.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.keys()
            .hasAny(['plan', 'creditsUsedThisMonth', 'monthResetAt', 'stripeCustomerId',
                     'creditsBalance', 'emailDeliverable', 'emailVerified',
                     'scansToday', 'scanDate']);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plan', 'creditsUsedThisMonth', 'monthResetAt', 'stripeCustomerId',
                     'creditsBalance', 'emailDeliverable', 'emailVerified',
                     'scansToday', 'scanDate']);
      allow delete: if false;
    }

    match /cache/{cacheId} {
      allow read, write: if false;
    }

    // The owner's detection verdicts from /admin/training. Written only by the
    // admin API route with the Admin SDK, and read only by the detection
    // worker, which also uses the Admin SDK — both bypass these rules. Nothing
    // in the browser has any business here: these labels steer what every
    // user's job gets flagged for.
    match /detection_labels/{pairId} {
      allow read, write: if false;
    }
  }
}
